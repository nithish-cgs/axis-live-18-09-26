<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.web>
  
<customErrors mode="RemoteOnly" defaultRedirect="Sample.html">
      <error redirect="Sample.html" statusCode="404" />
      <error redirect="Sample.html" statusCode="301" />
      <error redirect="Sample.html" statusCode="500" />
      <error redirect="Sample.html" statusCode="401" />
      <error redirect="Sample.html" statusCode="403" />
      <error redirect="Sample.html" statusCode="400" />
      <error redirect="Sample.html" statusCode="501" />
    </customErrors>

    <compilation debug="false" targetFramework="4.5" />
    <httpRuntime enableVersionHeader="false" />
 <httpCookies requireSSL="true" httpOnlyCookies="true" />
        <!-- <authentication mode="Forms">
            <forms cookieless="UseCookies" />
        </authentication> -->
	<trust level="Full" />
  </system.web>
    <system.webServer>	
	<httpProtocol>
   <customHeaders>
                <remove name="Strict-Transport-Security" />
                <remove name="X-Content-Type-Options" />
                <remove name="X-Xss-Protection" />
                <remove name="X-Frame-Options" />
	  <remove name="Server" />
                <add name="X-Frame-Options" value="SAMEORIGIN" />
                <!-- <add name="Content-Security-Policy" value="default-src https: data: 'unsafe-inline' data: blob: digitalaccountuat.axissl.in " /> -->
                <add name="X-Xss-Protection" value="1;mode=block" />
                <add name="X-Content-Type-Options" value="nosniff" />
                <add name="Strict-Transport-Security" value="max-age=31536000;includeSubDomains" />
                <add name="Public" value="GET,POST,HEAD" />
                <add name="Allow" value="GET,POST,HEAD" />
                <add name="Cache-Control" value="No-Cache" />
                <add name="Content-Security-Policy" value="default-src https: data: 'unsafe-inline' 'unsafe-eval' data: blob: tracking.affiliatehub.co.in aqugen.go2cloud.org google-analytics.com" />    
